# --- Raw BLS downloads (re-fetchable; see README) ---------------------------
# The AllData file is ~389 MB, well over GitHub's 100 MB per-file hard limit.
# The small ln.* mapping files ARE tracked -- they are a few KB each and are
# what make the series IDs decodable.
data/ln.data.*
data/ln.series.txt

# --- CPS basic monthly microdata (fetch_cps.sh output) ----------------------
data/cps/
*.dat
*pub.csv

# --- v2 API pipeline --------------------------------------------------------
# Cached API responses are re-fetchable; the API key must never be committed.
v2/cache/
.env

# --- Python -----------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]

# --- Editor / OS ------------------------------------------------------------
.idea/
.DS_Store
